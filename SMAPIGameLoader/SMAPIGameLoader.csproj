<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net9.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<ApplicationId>io.github.ncxxi.kitsune</ApplicationId>
		<SupportedOSPlatformVersion>28.0</SupportedOSPlatformVersion>
		<AndroidSigningKeyStore>debug.keystore</AndroidSigningKeyStore>
		<PackageIcon>icon.png</PackageIcon>
		<Version></Version>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1.7</ApplicationDisplayVersion>
		<ApplicationVersion>$([System.DateTimeOffset]::Now.ToUnixTimeSeconds())</ApplicationVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Fix for .NET9 -->
		<NoWarn>$(NoWarn);CS1705;MSB3277</NoWarn>
		<GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
		<UserSecretsId>cf038a8b-f687-4737-9fa2-3fd11f1ceec7</UserSecretsId>

		<StartupHookSupport>true</StartupHookSupport>

	</PropertyGroup>
	<PropertyGroup>
		<!-- Set to true to require the Play Store/Galaxy Store split layout and a supported game version. -->
		<RequireGameChecks Condition="'$(RequireGameChecks)' == ''">false</RequireGameChecks>
		<DefineConstants Condition="'$(RequireGameChecks)' == 'true'">$(DefineConstants);REQUIRE_GAME_CHECKS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<PublishTrimmed>False</PublishTrimmed>
		<AndroidEnableSGenConcurrent>True</AndroidEnableSGenConcurrent>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningStorePass>android</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>android</AndroidSigningKeyPass>
		<IsAotCompatible>False</IsAotCompatible>
		<AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
		<RunAOTCompilation>False</RunAOTCompilation>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<AndroidEnableSGenConcurrent>True</AndroidEnableSGenConcurrent>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningStorePass>android</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>android</AndroidSigningKeyPass>
		<IsAotCompatible>False</IsAotCompatible>
		<AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
		<RunAOTCompilation>False</RunAOTCompilation>
		<EmbedAssembliesIntoApk>False</EmbedAssembliesIntoApk>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="6.0.1" />
		<PackageReference Include="Mono.Cecil" Version="0.11.5" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Octokit" Version="13.0.1" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="System.IO.Compression" Version="4.3.0" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.1.4" />
		<PackageReference Include="Xamarin.Essentials" Version="1.7.7" />
		<PackageReference Include="Xamarin.Google.Android.Material" Version="1.14.0.6" />

	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\AssemblyStore\AssemblyStore.csproj" />
		<ProjectReference Include="..\StardewValley.Stubs\StardewValley.Stubs.csproj">
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>
	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>..\SharedLibs\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Backports">
			<HintPath>..\SharedLibs\MonoMod.Backports.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Core">
			<HintPath>..\SharedLibs\MonoMod.Core.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Iced">
			<HintPath>..\SharedLibs\MonoMod.Iced.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.ILHelpers">
			<HintPath>..\SharedLibs\MonoMod.ILHelpers.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Utils">
			<HintPath>..\SharedLibs\MonoMod.Utils.dll</HintPath>
		</Reference>
		<Reference Include="MonoGame.Framework">
			<HintPath>..\StardewValley.Stubs\MonoGame.Framework.dll</HintPath>
			<Private>false</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<None Update="Resources\Drawable\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="Restore">
		<Message Text="Restoring dotnet tools" Importance="High" />
		<Exec Command="dotnet tool restore" IgnoreExitCode="true" />
	</Target>
</Project>